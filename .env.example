# ==============================================================================
# M.shaies Haute Parfumerie — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Supabase PostgreSQL Connection String (Transaction Pooler recommended for serverless)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Side Only Secrets (Never exposed to client bundles)
GEMINI_API_KEY=your-gemini-api-key-here

# Local Ollama fallback (install Ollama and pull the model first)
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Deployment Preset (e.g. "node-server", "vercel")
NITRO_PRESET=node-server
